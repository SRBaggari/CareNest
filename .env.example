# Copy to .env.local for local overrides. Never commit real secrets.

# PostgreSQL connection string. Leave unset in development to use the embedded
# PGlite database stored in .data/pglite (created and migrated automatically).
# DATABASE_URL=postgres://carenest:password@localhost:5432/carenest
# DATABASE_POOL_MAX=10

# Where embedded PGlite stores data when DATABASE_URL is unset.
# PGLITE_DATA_DIR=.data/pglite

# Public base URL of the app (used in invitation and notification links).
APP_URL=http://localhost:3000

# Outgoing email. Without SMTP_URL, emails are NOT sent: they are only written to the server
# log and shown as "logged" (not "sent") in delivery status.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# EMAIL_FROM=CareNest <no-reply@example.com>

# Uploaded health documents are stored here (default .data/documents). Back it up with the database.
# DOCUMENT_STORAGE_DIR=/data/documents

# Phone alerts (web push). Without these, phone alerts are off and the app says so.
# Create a pair once with:  npx web-push generate-vapid-keys   (keep the private key secret)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Background worker (reminders, alerts, email delivery). Run `npm run worker` alongside the app,
# or call POST /api/internal/tick every minute with `Authorization: Bearer $CRON_SECRET`.
# WORKER_INTERVAL_MS=30000
# CRON_SECRET=change-me-to-a-long-random-string

# Set to true ONLY when CareNest runs behind a reverse proxy that overwrites X-Forwarded-For
# (nginx, a load balancer, a PaaS router). Otherwise the header is ignored, because clients
# could forge it to dodge rate limits.
# TRUST_PROXY=true
