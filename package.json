{
  "name": "carenest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project integration --project blackbox",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "worker": "tsx scripts/worker.ts",
    "test:coverage": "vitest run --coverage --project unit --project integration",
    "test:blackbox": "vitest run --project blackbox",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "test:postgres": "cross-env CARENEST_PG_TESTS=true vitest run --project postgres"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "drizzle-orm": "^0.45.4",
    "luxon": "^3.7.2",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.6.0-beta.19": true,
    "@embedded-postgres/linux-arm64@18.6.0-beta.19": true,
    "@embedded-postgres/darwin-arm64@18.6.0-beta.19": true,
    "@embedded-postgres/darwin-x64@18.6.0-beta.19": true
  }
}
